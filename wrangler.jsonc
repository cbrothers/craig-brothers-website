{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "craig-brothers-website",
  "main": "functions/_middleware.js",
  "compatibility_date": "2026-04-01",
  "workers_dev": false,
  "preview_urls": true,
  "routes": [
    {
      "pattern": "www.craigbrothers.com",
      "custom_domain": true
    },
    {
      "pattern": "craigbrothers.com",
      "custom_domain": true
    },
    {
      "pattern": "stage.craigbrothers.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  "kv_namespaces": [
    {
      "binding": "SECURITY_BANS",
      "id": "8042e1b5ee4b42279489114046987cf6"
    }
  ],
  "previews": {
    "kv_namespaces": [
      {
        "binding": "SECURITY_BANS",
        "id": "8042e1b5ee4b42279489114046987cf6"
      }
    ]
  },
  "observability": {
    "enabled": true
  }
}
